#!/usr/bin/env bash
set -euo pipefail

# headlong-discord-py — run a discord.py script as the identity's bot.
#
# Usage:
#   headlong-discord-py script.py [args...]
#   headlong-discord-py -c 'python code'
#
# Runs python in the discord/ project environment (discord.py installed) with
# DISCORD_BOT_TOKEN loaded from Headlong's env files. See skills/discord and
# discord/src/headlong_discord/script.py for the `run(main)` helper.

# Resolve through symlinks (install.sh --symlinks puts this on PATH), then
# fall back to the checkout recorded by install.sh / headlong-init.
ROOT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -d "$ROOT_DIR/discord" ]]; then
    _home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
    _rec=$(cat "$_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_rec" && -d "$_rec/discord" ]]; then ROOT_DIR="$_rec"
    elif [[ -d "$_home/app/discord" ]]; then ROOT_DIR="$_home/app"
    else echo "headlong-discord-py: can't find the headlong checkout (discord/ missing); set HEADLONG_HOME or run from a checkout" >&2; exit 1
    fi
fi

# Headlong's env files, loaded the way tools/persona and bin/llm load them:
# what is already exported wins, so systemd's EnvironmentFile
# still take precedence. Without this the bridge is the only entry point that
# cannot see the checkout's .env, and a token that lives there reads as absent.
_load_env() {
    local envfile="$1"
    [[ -f "$envfile" ]] || return 1
    local key val
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        [[ -n "${!key+x}" ]] && continue
        # shellcheck disable=SC1090  # sourcing the user's own env file
        val=$(set -a; . "$envfile" >/dev/null 2>&1; printf '%s' "${!key}") || { printf '%s: warning: could not read %s; ignoring it\n' "${0##*/}" "$envfile" >&2; return 0; }
        export "$key=$val"
    done < <(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*=.*/\2/p' "$envfile")
    return 0
}
_load_env "$ROOT_DIR/.env" || true
_load_env "${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}/.env" || true

command -v uv >/dev/null 2>&1 || { echo "headlong-discord-py: uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }

exec uv run --project "$ROOT_DIR/discord" python "$@"
